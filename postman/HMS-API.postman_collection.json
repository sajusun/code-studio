{
  "info": {
    "_postman_id": "hms-api-collection-v2",
    "name": "HMS - Hotel Management System API",
    "description": "Laravel HMS backend API collection for `/api/v1`.\n\nImport one environment from this folder, then run `Auth / Get CSRF cookie` and `Auth / Login` before protected endpoints.\n\nSeeded admin credentials: `admin@hms.com` / `password`.\nCollection scripts auto-fill future booking dates and capture IDs from common responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "app_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@hms.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "xsrf_token",
      "value": "",
      "type": "string"
    },
    {
